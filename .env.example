# Copy this file to .env and fill in your own credentials.
# NEVER commit a real .env file -- it is listed in .gitignore.
#
# If a Deepgram API key was ever committed to this repository (see
# README > Security), it must be treated as compromised: revoke it in the
# Deepgram console and generate a new one. Do not reuse an old key.

# Required
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional overrides (also configurable in config/settings.yaml)
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=fa
