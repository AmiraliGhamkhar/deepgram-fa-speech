# Source-checkout configuration for the Medical STT CLIENT.
# Copy this file to the repository root as .env and uncomment the settings
# you need. medical_stt/config.py loads that .env for source-checkout runs;
# shell/process environment variables take precedence over values in .env.
#
# The packaged Windows app does not read this file. Configure the host URL
# and client secret in the app instead; the secret is protected with Windows
# DPAPI. This file is for development on platforms without DPAPI and for CI.
#
# NEVER put a real secret in this example or commit a filled-in .env file.
# The host's Deepgram API key belongs only in the host service environment;
# it must never be set on the client. See host/.env.example for host settings.

# --- Host connection ----------------------------------------------------

# URL of your self-hosted session service. Must use https://, except that
# http:// is accepted for localhost development only. May also be set in
# config/settings.yaml.
# MEDICALSTT_HOST_URL=https://stt.example.com

# Client credential for the host. In legacy single-client mode this matches
# HOST_SHARED_SECRET; when the host uses HOST_CLIENTS_FILE, use the matching
# per-device secret generated by `python -m host.provision` instead.
# Use this environment override only for development/CI; on Windows enter the
# secret in the app so it can be stored with DPAPI.
# MEDICALSTT_HOST_SECRET=

# Device identity provisioned on the host by `python -m host.provision`.
# Required when the host uses a client registry (the recommended setup for
# multiple clinicians). This is an identifier, not a credential, and may
# instead be set as host_client_id in config/settings.yaml.
# MEDICALSTT_HOST_CLIENT_ID=doctor-01

# --- Local development --------------------------------------------------

# Relocate the per-user data directory. By default it is %APPDATA%\MedicalSTT
# on Windows, or $XDG_CONFIG_HOME/MedicalSTT on Linux/macOS (falling back to
# ~/.config/MedicalSTT when XDG_CONFIG_HOME is unset). Useful for isolated
# development and tests.
# MEDICALSTT_APP_DATA_DIR=

# Optional Deepgram recognition overrides. The validated Persian setup is
# nova-3 with language fa; these values otherwise default to config/settings.yaml.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=fa
