# Development only. The packaged Windows app does NOT read this file:
# on Windows the host URL and shared secret are entered in the app's
# settings panel, where the secret is protected with Windows DPAPI.
#
# NEVER commit a real .env file -- it is listed in .gitignore.
# These exist for source-checkout development on platforms without DPAPI
# (Linux/macOS) and for CI.


# Base URL of your self-hosted session service. Must be https://
# (http:// is accepted only for localhost).
# MEDICALSTT_HOST_URL=https://stt.example.com



# Shared secret; must match the host's HOST_SHARED_SECRET.
# MEDICALSTT_HOST_SECRET=



# Relocate the per-user data directory (default %APPDATA%\MedicalSTT).
# MEDICALSTT_APP_DATA_DIR=



# Optional overrides (also configurable in config/settings.yaml)
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=fa
