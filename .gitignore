# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml

# Per-device plaintext secrets written by `python -m host.provision`, and
# the client registry it appends to (hashes only, but never a repo file).
*.secret
device-secrets/
clients.txt

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Caches ---
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/
*.cover
.coverage
.coverage.*
htmlcov/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Logs / generated ---
*.log
logs/
*.tmp

# --- Local build outputs (never commit) ---
# Nuitka and PyInstaller outputs; the tree must stay secret-clean so the
# build script and CI can prove no credential is baked into any artifact.
MedicalSTT.spec
*.spec.README.md

