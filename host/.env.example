# Template for the self-hosted session service (host/).
#
# This service is the ONLY place the Deepgram API key exists. The desktop
# app never receives it: it authenticates here with its client credentials
# and gets back a ~30s Deepgram session token.
#
# NEVER commit a filled-in copy of this file. host/.env is git-ignored;
# keep real values in your process manager or secret store (systemd
# EnvironmentFile, `docker run --env-file`, ...).
#
# Note: host/app.py reads these from the *process environment*. It does not
# parse this file itself, so load it with your process manager, or with
# `set -a; . host/.env; set +a` before `python -m host.app`.
#
# Every variable below is one the service actually reads. The authoritative
# list, with defaults and the refusal conditions, is the settings table in
# host/README.md; tests/test_host_docs.py fails CI if the two drift apart.
# Uncommented lines are the required settings; commented lines show the
# default the code uses when the variable is absent.


# --- Required ---------------------------------------------------------

# The Deepgram API key. Needs at least Member permission to call
# /v1/auth/grant. It must never appear in the client, its executable, or
# any file the client writes.
DEEPGRAM_API_KEY=

# --- Client identity (choose one of the two) --------------------------

# Multi-clinician mode: a `client_id:sha256hex` registry, one line per
# device, written by `python -m host.provision`. Required whenever more
# than one clinician connects; the service refuses to start if any line is
# malformed, because one bad entry would otherwise take down every device.
# Keep the file outside the web root, mode 0600.
# HOST_CLIENTS_FILE=/home/<user>/secure/clients.txt

# Legacy single-identity mode: every client presents this as a bearer
# token. Ignored when HOST_CLIENTS_FILE is set. Minimum 24 characters --
# the service refuses to start with a shorter one. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOST_SHARED_SECRET=


# --- TLS ---------------------------------------------------------------

# PEM certificate and private key. Leave both empty only when TLS is
# terminated by a reverse proxy that sets X-Forwarded-Proto: https from an
# address listed in HOST_FORWARDED_ALLOW_IPS. With neither a certificate
# nor HOST_ALLOW_HTTP the app rejects every request with 400, so
# `python -m host.app` logs a warning explaining exactly that at startup.
HOST_TLS_CERTFILE=
HOST_TLS_KEYFILE=


# --- Listener ----------------------------------------------------------

# Read only by `python -m host.app` (the uvicorn entry point). Under
# cPanel/Passenger the web server owns the listener and these two have no
# effect -- see docs/CPANEL_HOSTING.md.
# HOST_BIND=0.0.0.0
# HOST_PORT=8443


# --- Session tokens ----------------------------------------------------

# Lifetime requested from Deepgram, and the upper bound a client may ask
# for (Deepgram's own maximum is 3600). Both are clamped to >= 5.
# HOST_DEFAULT_TTL_SECONDS=30
# HOST_MAX_TTL_SECONDS=3600


# --- Rate limiting -----------------------------------------------------

# Token buckets, so 50 colleagues pressing Start at once all succeed and
# only a genuinely looping client is throttled. All of them use
# HOST_RATE_LIMIT_WINDOW_SECONDS as their window.
#
#   per authenticated client_id:
# HOST_CLIENT_RATE_LIMIT_REQUESTS=60
# HOST_CLIENT_BURST=120
#
#   host-wide ceiling (protects the host from the aggregate):
# HOST_GLOBAL_RATE_LIMIT_REQUESTS=600
# HOST_GLOBAL_BURST=1200
#
#   failed authentication, budgeted per peer address (or, when the server
#   supplies no peer address, per validated client_id -- see
#   host/README.md > Rate limiting):
# HOST_AUTH_FAILURE_LIMIT=20
#
# HOST_RATE_LIMIT_WINDOW_SECONDS=60

# INERT -- kept only so existing deployments keep loading. This was the old
# per-IP fixed-window budget; session requests are now limited per
# authenticated client_id, so it has nothing to apply to. Setting it changes
# nothing and the service logs a warning saying so. Use
# HOST_CLIENT_RATE_LIMIT_REQUESTS / HOST_CLIENT_BURST instead.
# HOST_RATE_LIMIT_REQUESTS=30

# --- Request limits ----------------------------------------------------

# Body cap for POST /v1/session. A real request is a few dozen bytes, so
# this is abuse control: beyond it the response is 413, and the rejection is
# counted in request_body_rejections_total whether the client declared a
# Content-Length or streamed the body in chunks.
# HOST_MAX_REQUEST_BODY_BYTES=4096

# Concurrent in-flight Deepgram grant calls. Beyond this the response is
# 503 with a Retry-After header rather than an unbounded pile of open
# upstream connections. Well above the 50-session target on purpose.
# HOST_MAX_INFLIGHT_GRANTS=100


# --- The upstream call to Deepgram -------------------------------------

# Timeouts for the single HTTPS POST to Deepgram's token endpoint, and the
# size of the reused connection pool that makes it.
# HOST_GRANT_TIMEOUT_SECONDS=10
# HOST_GRANT_CONNECT_TIMEOUT_SECONDS=5
# HOST_GRANT_MAX_CONNECTIONS=100
# HOST_GRANT_MAX_KEEPALIVE_CONNECTIONS=20


# --- Observability -----------------------------------------------------

# If set, GET /metrics requires `Authorization: Bearer <token>`. If left
# empty /metrics is readable by anyone who can reach the port, and the
# service warns once at startup. It exposes no credential and no transcript,
# but it does expose traffic volume and the number of registered clients.
# HOST_METRICS_ADMIN_TOKEN=


# --- Reverse proxy and development -------------------------------------

# Which peers may set X-Forwarded-Proto (used for the HTTPS check when TLS
# is terminated by a proxy). Default: loopback only. Only the immediate peer
# is trusted, so a client cannot smuggle trust through a forged
# X-Forwarded-For chain.
# HOST_FORWARDED_ALLOW_IPS=127.0.0.1

# 1 serves plaintext HTTP. DEVELOPMENT ONLY -- a shared secret must never
# cross the wire unencrypted in production. On a cPanel/Passenger host where
# Apache terminates TLS, see docs/CPANEL_HOSTING.md for what this actually
# does and what HOST_FORWARDED_ALLOW_IPS cannot do there.
# HOST_ALLOW_HTTP=0
